{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "session-start"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "stop"],
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "stop"],
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "pre-push"],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*git*config*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*-c*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*ref*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*remote*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*fetch*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*branch*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*tag*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*checkout*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*git*switch*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "bash-guard"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-hook.mjs", "session-end"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
