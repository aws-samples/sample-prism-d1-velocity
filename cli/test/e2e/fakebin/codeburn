#!/usr/bin/env node
// Fake `codeburn export -f json -o <file> --from A --to B` for the dashboard e2e run. Demo numbers only.
// FAKE_CB=none -> exits 1 on every call; FAKE_CB=empty -> a valid export with no usage (the "no data yet" state);
// FAKE_CB_HISTORY=slow|fail -> the earlier-weeks export
// (a range that ends before this month) sleeps FAKE_CB_DELAY_MS (default 20000) or fails.
const fs = require('fs');
const a = process.argv.slice(2);
const opt = (k) => { const i = a.indexOf(k); return i >= 0 ? a[i + 1] : null; };
// sync (the codeburnurl suite): every call goes to $HOME/codeburn-calls.log. `sync setup <url>` prints the sign-in lines
// codeburn 0.9.24 prints (on stderr), waits FAKE_CB_SETUP_MS (default 4000) for the "login", then writes the sync config
// as codeburn does (the URL minus one trailing slash). Example URLs only; nothing is fetched.
if (a[0] === 'sync') {
  const H = process.env.HOME, cfg = require('path').join(H, '.config', 'codeburn', 'sync.json');
  fs.appendFileSync(require('path').join(H, 'codeburn-calls.log'), a.join(' ') + '\n');
  if (a[1] === 'setup') {
    const baseUrl = String(a[2]).replace(/\/$/, '');
    const auth = 'https://auth.example.com/oauth2/authorize?response_type=code&client_id=fakeclient&redirect_uri=' + encodeURIComponent('http://127.0.0.1:53682/callback') + '&scope=openid&state=fakestate&code_challenge=fakechallenge&code_challenge_method=S256';
    process.stderr.write(`Fetching discovery doc from ${baseUrl}...\n\nOpening browser for login...\nIf the browser doesn't open, visit:\n  ${auth}\n\nWaiting for login (5 min timeout)...\n`);
    setTimeout(() => {
      fs.mkdirSync(require('path').dirname(cfg), { recursive: true });
      fs.writeFileSync(cfg, JSON.stringify({ baseUrl, clientId: 'fakeclient', tracesPath: '/v1/traces', issuer: 'https://auth.example.com' }));
      process.stderr.write(`\n\u2713 Sync configured successfully.\n  Endpoint: ${baseUrl}\n`);
      process.exit(0);
    }, Number(process.env.FAKE_CB_SETUP_MS || 4000));
    return;
  }
  if (a[1] === 'status') {
    try { console.log('Endpoint: ' + JSON.parse(fs.readFileSync(cfg, 'utf8')).baseUrl + '\nAuth: configured'); } catch { console.error('Sync not configured.'); process.exit(1); }
    process.exit(0);
  }
  console.log('Synced 0 calls'); process.exit(0);
}
if (a[0] !== 'export') { console.log('codeburn 0.9.24 (fake)'); process.exit(0); }
if (process.env.FAKE_CB === 'none') { console.error('codeburn: no data directory found'); process.exit(1); }
const from = opt('--from'), to = opt('--to'), out = opt('-o');
const home = process.env.HOME;
const p = (n) => String(n).padStart(2, '0');
const today = new Date(); const ym = `${today.getFullYear()}-${p(today.getMonth() + 1)}`;
const history = to < `${ym}-01`;
const days = [];
for (let d = new Date(from + 'T12:00:00'); ; d.setDate(d.getDate() + 1)) {
  const s = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  if (s > to) break;
  if (process.env.FAKE_CB === 'empty') continue;
  const n = d.getDate() * 7 + d.getMonth() * 3;
  if (n % 5 === 0) continue; // some days without usage
  days.push({ Date: s, 'Cost (USD)': Math.round(((n % 23) + 1) * 37) / 100, 'API Calls': (n % 40) + 3, Sessions: (n % 4) + 1,
    'Input Tokens': n * 1000, 'Output Tokens': n * 300, 'Cache Read Tokens': n * 5000 });
}
const sum = (k) => days.reduce((x, r) => x + r[k], 0);
const doc = {
  schema: 'codeburn.export.v2', generated: new Date().toISOString(), currency: { code: 'USD' },
  summary: [{ 'Cost (USD)': Math.round(sum('Cost (USD)') * 100) / 100, 'API Calls': sum('API Calls'), Sessions: sum('Sessions'), Projects: 3 }],
  periods: [{ daily: days,
    models: [{ Model: 'claude-sonnet-4.5', 'Cost (USD)': 41.2, 'API Calls': 310 }, { Model: 'claude-haiku-4.5', 'Cost (USD)': 3.9, 'API Calls': 120 }],
    activity: [{ Activity: 'coding', 'Cost (USD)': 30.1 }, { Activity: 'debugging', 'Cost (USD)': 9.4 }, { Activity: 'review', 'Cost (USD)': 5.6 }] }],
  projects: [
    { Project: `${home}/src/demo-shop`, 'Cost (USD)': 28.4, Sessions: 19 },
    { Project: `${home}/src/payments-api`, 'Cost (USD)': 12.1, Sessions: 7 },
    { Project: `${home}/scratch/notes`, 'Cost (USD)': 4.6, Sessions: 3 },
  ],
  tools: [{ Tool: 'Read', Calls: 410 }, { Tool: 'Edit', Calls: 220 }, { Tool: 'Bash', Calls: 160 }],
};
const finish = () => { fs.writeFileSync(out, JSON.stringify(doc)); process.exit(0); };
if (history && process.env.FAKE_CB_HISTORY === 'fail') { console.error('codeburn: history store is locked'); process.exit(2); }
if (history && process.env.FAKE_CB_HISTORY === 'slow') setTimeout(finish, Number(process.env.FAKE_CB_DELAY_MS || 20000));
else finish();
