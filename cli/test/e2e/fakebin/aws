#!/bin/sh
# Fake AWS CLI for the dashboard e2e run: it never contacts AWS. Every call is logged to
# $HOME/aws-calls.log and answers like the real CLI with no credentials configured.
# FAKE_AWS=in-progress: answers as the seeded demo account (AWS's example id 111122223333) whose
# Security Agent code review job-demo-2 is still IN_PROGRESS, so security findings exits 2.
# FAKE_AWS=complete: the same account, with job-demo-2 COMPLETED and two findings.
# FAKE_SA (the Security Agent page's setup gate, with FAKE_AWS set): ready: the agent space and scan
# bucket SSM names exist; slow: the same after 3 s; sso: the SSO sign-in expired; denied: the role may
# not call securityagent:ListAgentSpaces; nospace: no agent space and no SSM parameters.
echo "$*" >> "$HOME/aws-calls.log"
# $HOME/fake-aws-mode, when present, wins over FAKE_AWS: a test switches a running dashboard's answers (in-progress, then complete).
if [ -f "$HOME/fake-aws-mode" ]; then FAKE_AWS=$(cat "$HOME/fake-aws-mode"); fi
case "$1" in
  --version) echo "aws-cli/2.36.0-fake Python/3 Linux"; exit 0 ;;
  configure)
    if [ "$2" = "list-profiles" ]; then sed -n 's/^\[profile \(.*\)\]$/\1/p; s/^\[default\]$/default/p' "$HOME/.aws/config"; exit 0; fi ;;
esac
if [ "$FAKE_SA" = "sso" ] && [ "$1 $2" = "sts get-caller-identity" ]; then
  echo "" >&2; echo "Error when retrieving token from sso: Token has expired and refresh failed" >&2; exit 255
fi
if [ "$FAKE_SA" = "slow" ] && [ "$1 $2" = "sts get-caller-identity" ]; then sleep 3; fi
case "$FAKE_SA:$1 $2" in
  ready:"securityagent list-agent-spaces"|slow:"securityagent list-agent-spaces") echo '{"agentSpaceSummaries":[{"agentSpaceId":"as-0demo0000000001","name":"prism-d1-security"}]}'; exit 0 ;;
  ready:"securityagent batch-get-agent-spaces"|slow:"securityagent batch-get-agent-spaces") echo '{"agentSpaces":[{"agentSpaceId":"as-0demo0000000001","createdAt":"2026-11-03T00:00:00Z","awsResources":{"s3Buckets":["arn:aws:s3:::prism-demo-scans"]}}]}'; exit 0 ;;
  ready:"ssm get-parameter"|slow:"ssm get-parameter")
    case "$*" in
      *"--name /prism/continuum/agent-space-id "*) echo '{"Parameter":{"Value":"as-0demo0000000001"}}'; exit 0 ;;
      *"--name /prism/continuum/scan-bucket "*) echo '{"Parameter":{"Value":"prism-demo-scans"}}'; exit 0 ;;
    esac ;;
  denied:"securityagent list-agent-spaces") echo "" >&2; echo "An error occurred (AccessDeniedException) when calling the ListAgentSpaces operation: User: arn:aws:sts::111122223333:assumed-role/PrismDemoReadOnly/demo-session is not authorized to perform: securityagent:ListAgentSpaces" >&2; exit 254 ;;
  nospace:"securityagent list-agent-spaces") echo '{"agentSpaceSummaries":[]}'; exit 0 ;;
esac
if [ "$FAKE_AWS" = "in-progress" ] || [ "$FAKE_AWS" = "complete" ]; then
  case "$1 $2" in
    "sts get-caller-identity") echo '{"Account":"111122223333","Arn":"arn:aws:sts::111122223333:assumed-role/PrismDemoReadOnly/demo-session"}'; exit 0 ;;
    "iam list-account-aliases") echo '{"AccountAliases":["demo-dev"]}'; exit 0 ;;
    "ssm get-parameter") echo "" >&2; echo "An error occurred (ParameterNotFound) when calling the GetParameter operation: " >&2; exit 254 ;;
  esac
fi
# FAKE_AWS=complete: job-demo-2 has finished with two findings, one whose text carries markup (it must show as text).
# FAKE_PT=1 (with FAKE_AWS set): the calls `security pentest` makes, for the Run buttons' e2e. The job's status is
# $HOME/fake-pt-job (default IN_PROGRESS); $HOME/fake-pt-teardown=fail makes every stack deletion end DELETE_FAILED.
if [ -n "$FAKE_PT" ] && { [ "$FAKE_AWS" = "in-progress" ] || [ "$FAKE_AWS" = "complete" ]; }; then
  JOB=IN_PROGRESS; [ -f "$HOME/fake-pt-job" ] && JOB=$(cat "$HOME/fake-pt-job")
  case "$1 $2" in
    "cloudformation describe-stacks")
      if [ -f "$HOME/fake-pt-deleting" ]; then
        if [ "$(cat "$HOME/fake-pt-teardown" 2>/dev/null)" = "fail" ]; then echo '{"Stacks":[{"StackStatus":"DELETE_FAILED","StackStatusReason":"The following resource(s) failed to delete: [AgentSg]. (demo)"}]}'; exit 0; fi
        echo "" >&2; echo "An error occurred (ValidationError) when calling the DescribeStacks operation: Stack with id demo does not exist" >&2; exit 254
      fi
      echo '{"Stacks":[{"StackStatus":"CREATE_COMPLETE","Outputs":[{"OutputKey":"VpcArn","OutputValue":"arn:aws:ec2:us-west-2:111122223333:vpc/vpc-demo"},{"OutputKey":"SubnetArns","OutputValue":"arn:aws:ec2:us-west-2:111122223333:subnet/subnet-a,arn:aws:ec2:us-west-2:111122223333:subnet/subnet-b"},{"OutputKey":"AgentSecurityGroupArn","OutputValue":"arn:aws:ec2:us-west-2:111122223333:security-group/sg-agent"},{"OutputKey":"ServiceRoleArn","OutputValue":"arn:aws:iam::111122223333:role/prism-pentest-demo"},{"OutputKey":"AgentLogGroup","OutputValue":"/aws/securityagent/prism-pentest-demo"},{"OutputKey":"PrivateHost","OutputValue":"app.demo-shop.prism.internal"},{"OutputKey":"SourceBucket","OutputValue":"prism-pentest-demo-src"},{"OutputKey":"TargetGroupArn","OutputValue":"arn:aws:elasticloadbalancing:us-west-2:111122223333:targetgroup/app/1"},{"OutputKey":"AppLogGroup","OutputValue":"PrismPentest-demo-AppLogs"},{"OutputKey":"ExpiresAt","OutputValue":"2026-11-18T10:00:00Z"}]}]}'; exit 0 ;;
    "cloudformation delete-stack") touch "$HOME/fake-pt-deleting"; echo '{}'; exit 0 ;;
    "cloudformation describe-stack-events") echo '{"StackEvents":[{"LogicalResourceId":"AgentSg","ResourceType":"AWS::EC2::SecurityGroup","ResourceStatus":"DELETE_FAILED","ResourceStatusReason":"resource sg-agent has a dependent object (demo)"}]}'; exit 0 ;;
    "s3api put-object") echo '{}'; exit 0 ;;
    "elbv2 describe-target-health") echo '{"TargetHealthDescriptions":[{"Target":{"Id":"10.80.0.5","Port":3000},"TargetHealth":{"State":"healthy"}}]}'; exit 0 ;;
    "ec2 describe-network-interfaces") echo '{"NetworkInterfaces":[]}'; exit 0 ;;
    "securityagent create-target-domain") echo '{"targetDomainId":"td-demo","verificationStatus":"PENDING"}'; exit 0 ;;
    "securityagent verify-target-domain") echo '{"status":"UNREACHABLE"}'; exit 0 ;;
    "securityagent create-agent-space") echo '{"agentSpaceId":"as-pt-demo"}'; exit 0 ;;
    "securityagent create-pentest") echo '{"pentestId":"pt-demo"}'; exit 0 ;;
    "securityagent start-pentest-job")
      N=$(( $(cat "$HOME/fake-pt-n" 2>/dev/null || echo 0) + 1 )); echo "$N" > "$HOME/fake-pt-n"
      echo "{\"pentestJobId\":\"ptj-run-$N\",\"status\":\"IN_PROGRESS\",\"createdAt\":\"2026-11-17T10:00:00Z\"}"; exit 0 ;;
    "securityagent batch-get-pentest-jobs")
      ID=""; prev=""; for a in "$@"; do [ "$prev" = "--pentest-job-ids" ] && ID=$a; prev=$a; done
      echo "{\"pentestJobs\":[{\"pentestJobId\":\"$ID\",\"status\":\"$JOB\",\"createdAt\":\"2026-11-17T10:00:00Z\",\"updatedAt\":\"2026-11-17T12:50:00Z\",\"steps\":[{\"name\":\"PENTEST\",\"status\":\"$JOB\"}]}]}"; exit 0 ;;
    "securityagent list-findings") echo '{"findingsSummaries":[]}'; exit 0 ;;
    "securityagent stop-pentest-job"|"securityagent batch-delete-pentests"|"securityagent delete-agent-space"|"securityagent delete-target-domain") echo '{}'; exit 0 ;;
  esac
fi
if [ "$FAKE_AWS" = "complete" ]; then
  case "$1 $2" in
    "securityagent batch-get-code-review-jobs") echo '{"codeReviewJobs":[{"codeReviewJobId":"job-demo-2","status":"COMPLETED","createdAt":"2026-11-15T10:00:00Z","updatedAt":"2026-11-15T10:14:00Z"}]}'; exit 0 ;;
    "securityagent list-findings") echo '{"findingsSummaries":[{"findingId":"fd-1","name":"SQL injection in order lookup","riskLevel":"CRITICAL"},{"findingId":"fd-2","name":"Missing rate limit on login","riskLevel":"LOW"}]}'; exit 0 ;;
    "securityagent batch-get-findings") echo '{"findings":[{"findingId":"fd-1","name":"SQL injection in order lookup","riskLevel":"CRITICAL","riskType":"CWE-89","description":"The order id from the query string is concatenated into a SQL string. Demo text with markup: <img src=x onerror=alert(1)> stays text. This description is longer than two hundred characters so the drill-down shows that the full text is saved now rather than the first two hundred characters only.","codeLocations":[{"filePath":"src/orders.ts","lineStart":42}]},{"findingId":"fd-2","name":"Missing rate limit on login","riskLevel":"LOW","description":"No rate limit.","codeLocations":[{"filePath":"src/login.ts","lineStart":5}]}]}'; exit 0 ;;
  esac
fi
if [ "$FAKE_AWS" = "in-progress" ]; then
  case "$1 $2" in
    "securityagent batch-get-code-review-jobs") echo '{"codeReviewJobs":[{"codeReviewJobId":"job-demo-2","status":"IN_PROGRESS","createdAt":"2026-11-15T10:00:00Z"}]}'; exit 0 ;;
  esac
fi
echo "" >&2
echo "Unable to locate credentials. You can configure credentials by running \"aws configure\"." >&2
exit 253
